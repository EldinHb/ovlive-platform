# Configuration for docker-compose.prod.yml.
#
#   cp .env.prod.example .env && $EDITOR .env
#   docker compose -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.prod.yml up -d
#
# Compose reads `.env` natively — no shell is involved, so values are taken literally and must
# NOT be quoted here. (Never `source` this file: GTFS_USER_AGENT's parentheses are shell syntax.)
# Prefer real environment variables from a systemd unit or secret manager if you'd rather not
# have secrets on disk; anything already exported wins over this file.

# --- Images (must match where CI pushed them) ---
# ghcr.io/<your-github-username>, or your own registry. Lowercase only — ghcr rejects uppercase.
IMAGE_PREFIX=ghcr.io/your-github-username
# `latest`, or pin a sha-<short> tag so a rollback is a one-line change.
IMAGE_TAG=latest

# --- GTFS identification (REQUIRED — `up` aborts without it) ---
# Must name your deployment and a contact address the feed operators can actually reach. A
# strict policy, not a formality: see the data-source rules in CLAUDE.md. Use your own address
# — leaving someone else's here points your traffic's complaints at them.
GTFS_USER_AGENT=OVLive/0.1 (+contact: you@example.com)

# --- Secrets (REQUIRED — no defaults; `up` aborts if unset) ---
POSTGRES_PASSWORD=
# Seeds the admin account on the first boot only, while the users table is still empty.
# Changing these afterwards does nothing — manage the account through the API instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Ingress ---
# Host port for the web container — the SPA, REST API, /docs and the WebSocket all arrive here.
# Accepts a bind address as well as a bare port, so 127.0.0.1:8080 keeps it off the LAN and
# reachable only by a proxy running on the same host.
WEB_PORT=8080

# Cloudflare Tunnel: serve the stack on a public hostname with no inbound port on your router.
# Off unless you opt in — uncomment BOTH lines and set the token. The profile is what makes the
# cloudflared container run at all; without it the stack is just WEB_PORT above.
#   Token: Zero Trust → Networks → Tunnels → your tunnel → the install command's token.
#   Add one public hostname routed to HTTP → web:80, and turn on WebSocket support for the
#   tunnel (Network → Settings) — /v1/stream is the whole live map and fails closed without it.
# Pair it with WEB_PORT=127.0.0.1:8080 so the tunnel is the only way in.
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional ---
# POSTGRES_USER=ovlive
# POSTGRES_DB=ovlive
# RUST_LOG=info,ovlive=info
# WS_TICK_HZ=3
# PUBLIC_RATE_PER_MIN=6000
# Leave empty for same-origin (nginx proxies the API). Set to https://api.example.com only
# if the backend is published on its own hostname.
# API_BASE=
