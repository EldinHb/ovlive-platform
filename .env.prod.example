# Host environment for docker-compose.prod.yml.
#
# Everything here is read from the *host* environment — export these in your shell, your
# systemd unit, or a secret manager. Copy to `.env` next to the compose file only if you
# accept secrets living on disk; compose reads `.env` automatically.
#
#   docker compose -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.prod.yml up -d

# --- Images (must match the IMAGE_PREFIX the CI workflow pushes to) ---
IMAGE_PREFIX=ghcr.io/my-org
IMAGE_TAG=latest

# --- GTFS identification (required; not a secret, but `up` fails if it's unset) ---
# STRICT policy, see CLAUDE.md: this must name the app and a contact address the operators
# can actually reach. Note the parentheses and spaces — quote it when exporting from a shell,
# and never `source` this file (docker compose reads it natively, no shell involved).
GTFS_USER_AGENT=OVLive/0.1 (+contact: you@example.com)

# --- Secrets (no defaults; `up` fails if these are unset) ---
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Zero Trust → Networks → Tunnels → your tunnel → the token from the install command.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional ---
# POSTGRES_USER=ovlive
# POSTGRES_DB=ovlive
# RUST_LOG=info,ovlive=info
# WS_TICK_HZ=3
# PUBLIC_RATE_PER_MIN=6000
# Leave empty for same-origin (nginx proxies the API). Set to https://api.example.com only
# if the backend is published on its own hostname.
# API_BASE=
