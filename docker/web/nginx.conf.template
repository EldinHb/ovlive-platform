# Rendered to /etc/nginx/conf.d/default.conf at container start by 10-ovlive-config.sh.
# Only ${API_UPSTREAM} is substituted — nginx's own $variables must survive envsubst intact.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS. Needed because proxy_pass below goes through a variable, which
    # defers name resolution to request time: with a literal upstream, nginx resolves once at
    # start-up (failing outright if the backend container isn't up yet) and then caches that
    # IP forever, so a server restart would leave this proxying into the void.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $ovlive_api http://${API_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Container liveness. /health is the *backend's* endpoint and is proxied below, so it
    # can't double as nginx's own check.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Rewritten on every container start — caching it would pin a stale backend URL into
    # browsers for as long as the cache lives.
    location = /config.js {
        add_header Cache-Control "no-store" always;
    }

    # Vite emits content-hashed filenames here, so these are immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The protobuf live stream. Must be matched before the /v1 prefix and carry the Upgrade
    # headers, or the handshake comes back as a plain HTTP response and the SPA reconnect-loops.
    location = /v1/stream {
        proxy_pass $ovlive_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Diffs flow at WS_TICK_HZ (3/s) while a viewport has vehicles, but an empty viewport
        # is legitimately silent. Don't let nginx reap the socket under it.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # REST, health, and the embedded API docs.
    location ~ ^/(v1/|health$|docs$|docs/|openapi\.json$) {
        proxy_pass $ovlive_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # SPA: every other path is a client-side route, so serve the shell and let the router
    # sort it out.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
