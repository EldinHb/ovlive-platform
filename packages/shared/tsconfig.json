{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["geojson"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ovlive/api-types": ["../api-types/src/index.ts"]
    }
  }
}
