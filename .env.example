# --- Server ---
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,ovlive=debug
DATA_DIR=./data

# --- Database ---
DATABASE_URL=postgres://ovlive:ovlive@localhost:5432/ovlive

# --- GTFS static (STRICT policy — see CLAUDE.md) ---
GTFS_URL=https://gtfs.ovapi.nl/gtfs-nl.zip
# REQUIRED — no default exists, and the server refuses to start without it.
#
# Replace the address below with one *you* read. The feeds are free and community-run, and
# this header is the only way an operator can reach whoever is fetching ~232 MiB a day. Leaving
# someone else's address here points their complaints at the wrong person.
GTFS_USER_AGENT=OVLive/0.1 (+contact: you@example.com)
# Cron-ish daily refresh. Timezone for the 03:00 check.
GTFS_REFRESH_TZ=Europe/Amsterdam
GTFS_REFRESH_HOUR=3

# --- Realtime ZMQ (fair use: 1 connection per stream) ---
ZMQ_KV6_ENDPOINT=tcp://pubsub.besteffort.ndovloket.nl:7658
# Comma-separated envelope prefixes to subscribe to. Empty = all.
ZMQ_KV6_TOPICS=
# Reconnect the SUB socket if no frame arrives within this many seconds (watchdog for
# silently-dead connections that never surface a recv() error).
ZMQ_IDLE_TIMEOUT_SECS=60

# --- Realtime state tuning ---
STALE_TRIP_SECS=240
SWEEP_INTERVAL_SECS=30
SNAPSHOT_INTERVAL_SECS=20
# Viewport diff tick rate (Hz) for the WS fan-out.
WS_TICK_HZ=3
# Requests/minute shared across ALL anonymous (keyless) callers — the web app's path.
PUBLIC_RATE_PER_MIN=6000

# --- Deprecated compatibility endpoints (crates/api/src/legacy.rs) ---
# Same names as the pre-Rust API so existing tuning carries over. Remove these together
# with those endpoints. MAX_VIEWPORT_AREA is in square degrees; larger viewports are
# rejected with "viewport too large".
MAX_VIEWPORT_AREA=2.0
MAX_SPATIAL_RESULTS=1500
MAX_STOPS_RESULTS=500

# --- Admin seed (created on first boot if the users table is empty) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
